# Copy this file to .env and adjust values for your environment.
# `.env` is gitignored; `.env.example` is the team template.

# --- Required ---

# Min 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=change_me_in_production_min_32_chars

# --- Optional (defaults match docker-compose.yml) ---

# Runtime mode for the backend. Use "development" locally to enable Swagger UI at /docs.
NODE_ENV=production

# Mongo connection string. Default points to the in-network `mongo` service.
# Override when using a managed Mongo (e.g. Atlas).
MONGO_URI=mongodb://mongo:27017/league-of-ping-pong

# Comma-separated list of allowed origins for the backend CORS policy.
# Must include the public URL of the frontend.
CORS_ORIGIN=http://localhost:8080

# Host ports published by Docker. Change if 3000/8080 are taken.
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=8080

# Baked into the frontend bundle at build time as `import.meta.env.VITE_API_URL`.
# In prod set to the public backend URL (https://api.example.com).
VITE_API_URL=http://localhost:3000
